{
  "name": "qaryat-atebaa-portal",
  "private": true,
  "type": "module",
  "description": "بوابة قرية الأطباء — Qaryat Al-Atebaa community portal.",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "node tools/lint-no-sql.mjs && node tools/lint-rtl.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:unit": "npm run build && node --test .build/tests/unit/money.test.js .build/tests/unit/s3sign.test.js .build/tests/unit/webpush.test.js .build/tests/unit/image.test.js .build/tests/unit/quiet.test.js",
    "test:access": "npm run build && node --test .build/tests/access/access.test.js .build/tests/access/audit.test.js .build/tests/access/auth.test.js .build/tests/access/onboarding.test.js .build/tests/access/transparency.test.js .build/tests/access/views.test.js .build/tests/access/expenses.test.js .build/tests/access/payment_reversal.test.js .build/tests/access/notifications.test.js .build/tests/access/content.test.js .build/tests/access/settlements.test.js .build/tests/access/board_config.test.js",
    "verify:ledger": "python3 tests/fixtures/verify_ledger.py",
    "verify:demo": "python3 tests/fixtures/verify_demo.py",
    "seed:demo": "python3 seed/demo/generate.py",
    "preview": "python3 tests/fixtures/render_preview.py",
    "verify": "npm run lint && npm run typecheck && npm run test:unit && npm run test:access && npm run verify:ledger && npm run verify:demo && npm run drill:restore && npm run screens && npm run a11y",
    "screens": "npm run build && node .build/tests/fixtures/render_screens.js",
    "verify:d1": "bash tools/verify-d1.sh",
    "gen:vapid": "node tools/gen-vapid.mjs",
    "drill:restore": "node tools/restore-drill.mjs",
    "backup": "node tools/backup.mjs",
    "a11y": "node tools/a11y-scan.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.0",
    "@simplewebauthn/browser": "^13.3.0",
    "@simplewebauthn/server": "^13.3.2",
    "hono": "^4.13.0"
  }
}
